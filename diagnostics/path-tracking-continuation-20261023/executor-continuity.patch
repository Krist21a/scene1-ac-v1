+
+    def test_continuous_release_keeps_sent_reference_and_measured_cartesian_goal(self):
+        reference, accepted = self.fixture()
+        self.a.wrist_config.update(release_reference_mode='continuous_command',
+            release_cartesian_open_hold=True, release_open_hold_position_gain=2.)
+        self.measured[11] = reference[11] + .7
+        sent = accepted.copy(); sent[8:15] += .02
+        self.a.observe_command(sent)
+        result, info = self.a._pending_action(self.measured, self.snapshot)
+        np.testing.assert_array_equal(result[8:15], sent[8:15])
+        np.testing.assert_array_equal(self.a.pending['base'][8:15], sent[8:15])
+        np.testing.assert_array_equal(info['release_reference_transfer']['requested_change_rad'], np.zeros(7))
+        np.testing.assert_array_equal(self.a.pending['release_hold_position'], self.measured[8:11])
+        np.testing.assert_array_equal(self.a.offset[8:15], np.zeros(7))
+        self.assertEqual(result[15], 0.)
+        held, _ = self.a._pending_action(self.measured, self.snapshot)
+        np.testing.assert_array_equal(held[8:15], sent[8:15])
+
+    def test_continuous_release_requires_actual_sent_command(self):
+        self.fixture()
+        self.a.wrist_config['release_reference_mode'] = 'continuous_command'
+        with self.assertRaisesRegex(RuntimeError, 'requires an observed sent command'):
+            self.a._pending_action(self.measured, self.snapshot)
+        self.assertEqual(self.a.pending['kind'], 'weighing')
+
+    def test_continuous_release_rejects_invalid_previous_command(self):
+        for invalid in [float('nan'), self.a.high[8]+.01]:
+            self.fixture()
+            self.a.wrist_config['release_reference_mode'] = 'continuous_command'
+            self.a.last_sent = self.raw.copy(); self.a.last_sent[8] = invalid
+            with self.assertRaisesRegex(RuntimeError, 'Previous release command is outside'):
+                self.a._pending_action(self.measured, self.snapshot)
