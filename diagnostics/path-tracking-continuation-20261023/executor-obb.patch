+def oriented_footprint(points_xy):
+    """Fit both robust dimensions and midpoint in one PCA coordinate frame."""
+    _, axes = np.linalg.eigh(np.cov(np.asarray(points_xy).T))
+    major, minor = axes[:, -1], axes[:, 0]
