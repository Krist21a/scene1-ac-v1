 class TableReferenceTests(unittest.TestCase):
+    def test_dense_recorded_table_reference_removes_sampling_size_alias(self):
+        fixtures = Path(__file__).parent / 'fixtures'
+        metadata = json.loads((fixtures / 'table_dense_seed2.json').read_text())
+        results = {}
+        for stride in (3, 1):
+            frames = []
+            for tag in ('reference', 'failure'):
+                with np.load(fixtures / metadata[tag]['file']) as data:
+                    snapshot = dict(data)
+                snapshot['table_z_base_m'] = metadata[tag]['plane']
+                frame = table_frame(table_hull(snapshot, stride=stride),
+                                    snapshot['table_z_base_m'], table_boundary(snapshot))
+                self.assertIsNotNone(frame)
+                frames.append(frame)
+            results[stride] = table_motion(*frames)
+            size_change = np.max(abs(frames[1]['size'] - frames[0]['size']))
+            if stride == 3:
+                self.assertGreater(size_change, .008)
+            else:
+                self.assertLess(size_change, .002)
+        self.assertIsNone(results[3])
+        self.assertIsNotNone(results[1])
+        self.assertLess(np.linalg.norm(results[1]['center_shift_m'][:2]), .03)
+
+    def test_dense_table_still_requires_visible_exterior_edges(self):
+        for clipped in (False, True):
+            with self.subTest(clipped=clipped):
+                snapshot = self.depth_fixture()
+                self.assertIsNotNone(table_frame(table_hull(snapshot, stride=1), 0., table_boundary(snapshot)))
+                if clipped:
+                    snapshot['rgb'][:20, 20:80] = [0, 130, 0]
+                    snapshot['depth_m'][:20, 20:80] = 2.
+                else:
+                    snapshot['rgb'][:30] = [90, 90, 90]
+                    snapshot['depth_m'][:30] = 1.9
+                self.assertIsNone(table_frame(table_hull(snapshot, stride=1), 0., table_boundary(snapshot)))
+
     def setUp(self):
         self.hull=np.array([[.2,-.9],[1.,-.9],[1.,.5],[.2,.5]],np.float32)
         self.reference=table_frame(self.hull,-.08)
